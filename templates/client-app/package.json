{
  "name": "cms-client-template",
  "version": "0.1.0",
  "private": true,
  "description": "Casca Next.js (template) de um workspace-cliente da fábrica criador-de-cms. O name/porta são reescritos no scaffold (cli/src/scaffold.ts).",
  "scripts": {
    "dev": "next dev -p 3010",
    "generate": "tsx ../../cli/src/codegen/run.ts --config ./client.config.ts",
    "prebuild": "pnpm --filter @cms-core/core run build && npm run generate",
    "build": "next build",
    "start": "next start -p 3010",
    "deploy": "vercel deploy --prod --cwd ../..",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "predb:generate": "npm run generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "postdb:migrate": "npm run harden:db",
    "harden:db": "tsx scripts/harden-db.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:locales": "tsx scripts/seed-locales.ts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cms-core/core": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "next": "^16.2.10",
    "postgres": "^3.4.9",
    "quill": "^2.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.17.2",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
