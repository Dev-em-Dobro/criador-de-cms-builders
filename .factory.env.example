# .factory.env.example — tokens do operador para o provisionamento (Fase 4, §7.4).
#
# COPIE para `.factory.env` (git-ignored, NUNCA commitar) e preencha. O preflight
# (cms-factory create-client, sem --skip-provision) valida a PRESENÇA destes
# tokens antes de tocar em qualquer provider.
#
# NEON_API_KEY só é EXIGIDO se algum config usa `database=neon` (§7.4 nota Neon).
# As demais chaves são sempre exigidas (auth é sempre Supabase na v1).

# --- Supabase (Management API) — criar projetos, ler api-keys, configurar SMTP ---
SUPABASE_ACCESS_TOKEN=            # Dashboard → Account → Access Tokens
SUPABASE_ORG_ID=                 # Dashboard → Organization settings

# --- Neon (D5) — só se algum config usa database=neon ---
NEON_API_KEY=                    # Neon Console → Account settings → API Keys
# NEON_ORG_ID=                   # opcional (onde criar o projeto)
# NEON_PROJECT_ID=               # opcional (reusar projeto existente)

# --- Bunny.net — criar Storage Zone + Pull Zone ---
BUNNY_ACCOUNT_API_KEY=           # Bunny Dashboard → Account → API

# --- Resend — chave de CONTA (a sua), reusada entre clientes ---
RESEND_API_KEY=                  # Resend Dashboard (sua conta)

# --- Vercel — criar projeto/env/domain/deploy ---
VERCEL_TOKEN=                    # Vercel → Settings → Tokens
# VERCEL_TEAM_ID=                # se o projeto vive num team Vercel
